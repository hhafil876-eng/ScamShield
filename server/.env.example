# ScamShield Server Environment Configuration
PORT=5000

# MongoDB Connection String (MongoDB Atlas or local instance)
# Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority
MONGO_URI=your_mongodb_connection_string

# Secret key used for signing JSON Web Tokens (at least 32 characters required)
JWT_SECRET=replace_with_a_random_secret_at_least_32_characters

# Frontend Client Origin for CORS
# In production, configure the exact HTTPS frontend origin and use same-site frontend/API hosts.
CLIENT_ORIGIN=http://localhost:5173

# Production settings
NODE_ENV=development
JWT_EXPIRES_IN=7d
# Set explicit trusted proxy IPs/CIDRs only when the deployment requires forwarding headers.
TRUST_PROXY=
# Required for the Vercel API proxy. Set the same random value privately on Vercel and Render.
PROXY_SHARED_SECRET=
